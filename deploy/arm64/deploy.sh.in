#!/usr/bin/env bash
set -Eeuo pipefail

IFS=$'\n\t'
umask 077
export GIT_OPTIONAL_LOCKS=0

# This input template is rendered by tools/build_arm64_release_package.py; the
# resulting deploy.sh is then included in the package's exact SHA256SUMS set.
PACKAGE_DIR=__DEPLOY_PACKAGE_DIR__
RELEASE_COMMIT=__DEPLOY_RELEASE_COMMIT__
SOURCE_COMMIT=__DEPLOY_SOURCE_COMMIT__
EVIDENCE_MANIFEST_SHA256=__DEPLOY_EVIDENCE_SHA256__
BUNDLE_NAME=__DEPLOY_BUNDLE_NAME__
BUNDLE_SHA256=__DEPLOY_BUNDLE_SHA256__
FRONTEND_TREE_SHA256=__DEPLOY_FRONTEND_TREE_SHA256__
BACKUP_MOUNT=__DEPLOY_BACKUP_MOUNT__
BASELINE_COMMIT=__DEPLOY_BASELINE_COMMIT__
BASELINE_ROOT=__DEPLOY_BASELINE_ROOT__
BASE_VENV=__DEPLOY_BASE_VENV__
TDX_SQLITE_SOURCE=__DEPLOY_TDX_SQLITE_PATH__
TDX_SQLITE_SHA256=__DEPLOY_TDX_SQLITE_SHA256__
TDX_SQLITE_ROWS=__DEPLOY_TDX_SQLITE_ROWS__
TDX_INSTRUMENTS=__DEPLOY_TDX_INSTRUMENTS__
TDX_DATES=__DEPLOY_TDX_DATES__
TDX_FIRST_DATE=__DEPLOY_TDX_FIRST_DATE__
TDX_LAST_DATE=__DEPLOY_TDX_LAST_DATE__
TDX_PANEL_SOURCE=__DEPLOY_TDX_PANEL_PATH__
TDX_PANEL_SHA256=__DEPLOY_TDX_PANEL_SHA256__

STATE_ROOT=/srv/quantos/state
UNIT_ROOT=/etc/systemd/system
RELEASE="/opt/quantos/releases/$RELEASE_COMMIT"
VENV="/opt/quantos/venvs/$RELEASE_COMMIT"
FRONTEND="/opt/quantos/frontend/$RELEASE_COMMIT"
BUNDLE="$PACKAGE_DIR/$BUNDLE_NAME"
TDX_STATE_PARENT="$STATE_ROOT/data/stocks/pit"
TDX_STATE_DIR="$TDX_STATE_PARENT/tdx-windows-20260830"
TDX_SQLITE="$TDX_STATE_DIR/ashare_tdx_pit.sqlite"
TDX_PANEL="$TDX_STATE_DIR/ashare_tdx_pit.adv20000000.panel.npz"
ALPHA_RUNTIME_LOCK="$STATE_ROOT/data/cache/ashare_alpha_runtime.lock"
FRONTEND_HEALTH_URL=http://192.168.5.68:3100/

WORKERS=(
__DEPLOY_WORKERS__
)
FORBIDDEN_MODULES=(
__DEPLOY_FORBIDDEN_MODULES__
)
OLD_USER_UNITS=(
__DEPLOY_OLD_USER_UNITS__
)
SPECIAL_UNITS=(
  quantos-binance-realtime-stream.service
  quantos-bybit-realtime-stream.service
  quantos-l2-watchdog.service
  quantos-l2-watchdog.timer
)
SUPPORT_UNITS=(
  quantos-console-api.service
  quantos-console-frontend.service
  quantos-research-runner.service
)
RESIDENT_UNITS=(
  quantos-binance-realtime-stream.service
  quantos-bybit-realtime-stream.service
  quantos-console-api.service
  quantos-console-frontend.service
  quantos-research-runner.service
)

WORKER_SERVICES=()
WORKER_TIMERS=()
EARLY_WORKER_TIMERS=()
ALL_SWITCH_UNITS=()
for module in "${WORKERS[@]}"; do
  WORKER_SERVICES+=("quantos-l2@$module.service")
  WORKER_TIMERS+=("quantos-l2@$module.timer")
  if [[ "$module" != ashare_forward_observation ]]; then
    EARLY_WORKER_TIMERS+=("quantos-l2@$module.timer")
  fi
done
ALL_SWITCH_UNITS=(
  "${WORKER_SERVICES[@]}"
  "${WORKER_TIMERS[@]}"
  "${SPECIAL_UNITS[@]}"
  "${SUPPORT_UNITS[@]}"
)

CLONE_TMP=''
TRUSTED_PACKAGE_TMP=''
ROLLBACK_ROOT=''
PAIR_ROLLBACK_DIR=''
TDX_PAIR_STAGE=''
PAIR_NEEDS_REPLACE=0
PAIR_REPLACED=0
SWITCH_STARTED=0
UNITS_REPLACED=0
SUCCESS=0
CURRENT_STAGE=bootstrap
DEPLOY_STARTED_SECONDS=$SECONDS
STAGE_STARTED_SECONDS=$SECONDS
PREVIOUS_ENABLED_TIMERS=()
PREVIOUS_ACTIVE_TIMERS=()
PREVIOUS_ACTIVE_RESIDENTS=()
PREVIOUS_ENABLED_RESIDENTS=()
ALPHA_RUNTIME_SNAPSHOTTED=0
RESIDENTS_QUIESCED=0
ALPHA_DEPLOY_LOCK_FD=''
DEPLOY_LOCK_FD=''
NEW_INVOCATION_ID=''
ASHARE_SEARCH_INVOCATION_ID=''
ALPHA_RUNTIME_ARTIFACTS=(
  ashare_alpha_search.json
  ashare_forward_freeze.json
  ashare_forward_observation.db
  ashare_forward_observation.json
)

die() {
  printf 'DEPLOY_BLOCKED: %s\n' "$1" >&2
  return 1
}

stage_start() {
  CURRENT_STAGE=$1
  STAGE_STARTED_SECONDS=$SECONDS
  printf 'DEPLOY_STAGE_START stage=%s elapsed=%ss\n' \
    "$CURRENT_STAGE" "$((SECONDS - DEPLOY_STARTED_SECONDS))"
}

stage_pass() {
  local detail=${1:-ok}
  printf 'DEPLOY_STAGE_PASS stage=%s duration=%ss elapsed=%ss detail=%s\n' \
    "$CURRENT_STAGE" "$((SECONDS - STAGE_STARTED_SECONDS))" \
    "$((SECONDS - DEPLOY_STARTED_SECONDS))" "$detail"
}

unit_loaded() {
  local load_state
  load_state=$(systemctl show "$1" -p LoadState --value 2>/dev/null || true)
  [[ -n "$load_state" && "$load_state" != not-found ]]
}

stop_loaded_units_no_block() {
  local unit rc=0
  for unit in "$@"; do
    if unit_loaded "$unit"; then
      if ! systemctl stop --no-block "$unit"; then
        # A unit may disappear only if a concurrent daemon-reload races this
        # deployment.  Treat that final not-found state as already stopped,
        # while preserving every real stop failure.
        if unit_loaded "$unit"; then
          rc=1
        fi
      fi
    fi
  done
  return "$rc"
}

assert_no_unit_dropins() {
  local unit=$1
  local dropins reload
  dropins=$(systemctl show "$unit" -p DropInPaths --value 2>/dev/null || true)
  reload=$(systemctl show "$unit" -p NeedDaemonReload --value 2>/dev/null || true)
  [[ -z "$dropins" ]] || die "unit has unreviewed drop-ins: $unit paths=$dropins"
  [[ -z "$reload" || "$reload" == no ]] \
    || die "unit has an unapplied definition change: $unit"
}

stop_known_timers() {
  local unit rc=0
  for unit in "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer; do
    if unit_loaded "$unit"; then
      systemctl stop "$unit" || rc=1
    fi
  done
  return "$rc"
}

wait_for_units_inactive() {
  local timeout_seconds=$1
  shift
  local deadline unit active inflight
  deadline=$((SECONDS + timeout_seconds))
  while true; do
    inflight=''
    for unit in "$@"; do
      active=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
      if [[ "$active" == active || "$active" == activating \
        || "$active" == reloading || "$active" == deactivating ]]; then
        inflight+="${inflight:+,}$unit:$active"
      fi
    done
    [[ -z "$inflight" ]] && return 0
    if (( SECONDS >= deadline )); then
      printf 'DEPLOY_BLOCKED: units did not become inactive: %s\n' "$inflight" >&2
      return 124
    fi
    sleep 1
  done
}

stop_residents_and_verify() {
  local phase=$1
  local timeout_seconds=$2
  stage_start "$phase"
  stop_loaded_units_no_block "${RESIDENT_UNITS[@]}"
  wait_for_units_inactive "$timeout_seconds" "${RESIDENT_UNITS[@]}"
  RESIDENTS_QUIESCED=1
  stage_pass all_resident_readers_and_writers_inactive
}

acquire_alpha_deploy_lock() {
  stage_start alpha_runtime_exclusive_lock
  install -d -o quantos -g quantos -m 0700 "$STATE_ROOT/data/cache"
  if [[ -e "$ALPHA_RUNTIME_LOCK" || -L "$ALPHA_RUNTIME_LOCK" ]]; then
    [[ -f "$ALPHA_RUNTIME_LOCK" && ! -L "$ALPHA_RUNTIME_LOCK" ]] \
      || die 'A-share runtime lock path is unsafe'
  else
    install -o quantos -g quantos -m 0600 /dev/null "$ALPHA_RUNTIME_LOCK"
  fi
  exec {ALPHA_DEPLOY_LOCK_FD}>>"$ALPHA_RUNTIME_LOCK"
  flock -n "$ALPHA_DEPLOY_LOCK_FD" \
    || die 'A-share runtime is owned by a manual or legacy process'
  [[ $(stat -Lc '%d:%i' "$ALPHA_RUNTIME_LOCK") \
    == $(stat -Lc '%d:%i' "/proc/$$/fd/$ALPHA_DEPLOY_LOCK_FD") ]] \
    || die 'A-share runtime lock path was replaced while acquiring it'
  chown quantos:quantos "$ALPHA_RUNTIME_LOCK"
  chmod 0600 "$ALPHA_RUNTIME_LOCK"
  [[ $(stat -Lc '%d:%i:%U:%G:%a' "$ALPHA_RUNTIME_LOCK") \
    == $(stat -Lc '%d:%i:quantos:quantos:600' "/proc/$$/fd/$ALPHA_DEPLOY_LOCK_FD") ]] \
    || die 'A-share runtime lock ownership handoff contract failed'
  stage_pass deploy_holds_exact_alpha_runtime_flock
}

release_alpha_deploy_lock() {
  [[ -n "$ALPHA_DEPLOY_LOCK_FD" ]] || return 0
  flock -u "$ALPHA_DEPLOY_LOCK_FD"
  exec {ALPHA_DEPLOY_LOCK_FD}>&-
  ALPHA_DEPLOY_LOCK_FD=''
}

probe_alpha_lock_worker_access() {
  runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
    /usr/bin/python3 -P - "$ALPHA_RUNTIME_LOCK" <<'PY'
import os
import sys
descriptor = os.open(sys.argv[1], os.O_RDWR | os.O_APPEND)
os.close(descriptor)
PY
}

exchange_directories() {
  local left=$1
  local right=$2
  /usr/bin/python3 -P - "$left" "$right" <<'PY'
import ctypes
import os
import stat
import sys
from pathlib import Path

left, right = map(Path, sys.argv[1:3])
for path in (left, right):
    metadata = path.lstat()
    if not stat.S_ISDIR(metadata.st_mode):
        raise SystemExit(f"exchange endpoint is not a real directory: {path}")
if left.parent.resolve() != right.parent.resolve():
    raise SystemExit("exchange endpoints do not share one parent filesystem")
libc = ctypes.CDLL(None, use_errno=True)
renameat2 = getattr(libc, "renameat2", None)
if renameat2 is None:
    raise SystemExit("libc renameat2 is unavailable")
renameat2.argtypes = (
    ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint
)
renameat2.restype = ctypes.c_int
AT_FDCWD = -100
RENAME_EXCHANGE = 2
result = renameat2(
    AT_FDCWD,
    os.fsencode(left),
    AT_FDCWD,
    os.fsencode(right),
    RENAME_EXCHANGE,
)
if result != 0:
    code = ctypes.get_errno()
    raise OSError(code, os.strerror(code), f"{left} <-> {right}")
PY
}

wait_for_workers_to_drain() {
  local phase=$1
  local timeout_seconds=$2
  local deadline next_report unit active inflight
  stage_start "$phase"
  deadline=$((SECONDS + timeout_seconds))
  next_report=$SECONDS
  while true; do
    inflight=''
    for unit in "${WORKER_SERVICES[@]}"; do
      active=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
      if [[ "$active" == active || "$active" == activating \
        || "$active" == reloading || "$active" == deactivating ]]; then
        inflight+="${inflight:+,}$unit:$active"
      fi
    done
    if [[ -z "$inflight" ]]; then
      stage_pass all_oneshot_workers_inactive
      return 0
    fi
    if (( SECONDS >= deadline )); then
      die "in-flight workers did not drain and were left running: $inflight"
      return 124
    fi
    if (( SECONDS >= next_report )); then
      printf 'DEPLOY_STAGE_HEARTBEAT stage=%s duration=%ss elapsed=%ss inflight=%s\n' \
        "$CURRENT_STAGE" "$((SECONDS - STAGE_STARTED_SECONDS))" \
        "$((SECONDS - DEPLOY_STARTED_SECONDS))" "$inflight"
      next_report=$((SECONDS + 16))
    fi
    sleep 2
  done
}

wait_for_unit_completion() {
  local unit=$1
  local phase=$2
  local timeout_seconds=$3
  local allowed_statuses=${4:-0}
  local expected_invocation=${5:-}
  local stage_already_started=${6:-0}
  local deadline next_report active substate result status invocation
  if [[ -n "$expected_invocation" \
    && ! "$expected_invocation" =~ ^[0-9a-f]{32}$ ]]; then
    die "unit completion lacks a valid invocation identity: $unit"
    return 1
  fi
  if [[ "$stage_already_started" != 1 ]]; then
    stage_start "$phase"
  fi
  deadline=$((SECONDS + timeout_seconds))
  next_report=$((SECONDS + 16))
  while true; do
    invocation=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)
    if [[ -n "$expected_invocation" && "$invocation" != "$expected_invocation" ]]; then
      die "unit invocation changed before completion: $unit expected=$expected_invocation observed=$invocation"
      return 1
    fi
    active=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
    substate=$(systemctl show "$unit" -p SubState --value 2>/dev/null || true)
    if [[ "$active" != active && "$active" != activating \
      && "$active" != reloading && "$active" != deactivating ]]; then
      break
    fi
    if (( SECONDS >= deadline )); then
      die "unit exceeded its observation window and was left to systemd: $unit"
      return 124
    fi
    if (( SECONDS >= next_report )); then
      printf 'DEPLOY_STAGE_HEARTBEAT stage=%s duration=%ss elapsed=%ss unit=%s state=%s substate=%s\n' \
        "$CURRENT_STAGE" "$((SECONDS - STAGE_STARTED_SECONDS))" \
        "$((SECONDS - DEPLOY_STARTED_SECONDS))" "$unit" "$active" "$substate"
      next_report=$((SECONDS + 16))
    fi
    sleep 2
  done
  result=$(systemctl show "$unit" -p Result --value)
  status=$(systemctl show "$unit" -p ExecMainStatus --value)
  invocation=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)
  if [[ -n "$expected_invocation" && "$invocation" != "$expected_invocation" ]]; then
    die "unit invocation changed while reading its result: $unit"
    return 1
  fi
  [[ "$result" == success ]] || die "unit result is not success: $unit result=$result"
  [[ " $allowed_statuses " == *" $status "* ]] \
    || die "unit returned an unexpected status: $unit status=$status"
  stage_pass unit_complete
  printf 'DEPLOY_UNIT_PASS unit=%s result=%s status=%s active=%s\n' \
    "$unit" "$result" "$status" "$active"
}

wait_for_new_unit_invocation() {
  local unit=$1
  local previous_invocation=$2
  local timeout_seconds=$3
  local deadline next_report invocation job
  NEW_INVOCATION_ID=''
  deadline=$((SECONDS + timeout_seconds))
  next_report=$((SECONDS + 16))
  while true; do
    invocation=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)
    if [[ "$invocation" =~ ^[0-9a-f]{32}$ \
      && "$invocation" != "$previous_invocation" ]]; then
      NEW_INVOCATION_ID=$invocation
      return 0
    fi
    if (( SECONDS >= deadline )); then
      die "unit did not begin a new invocation: $unit previous=$previous_invocation observed=$invocation"
      return 124
    fi
    if (( SECONDS >= next_report )); then
      job=$(systemctl show "$unit" -p Job --value 2>/dev/null || true)
      printf 'DEPLOY_STAGE_HEARTBEAT stage=%s duration=%ss elapsed=%ss unit=%s waiting=new_invocation previous=%s observed=%s job=%s\n' \
        "$CURRENT_STAGE" "$((SECONDS - STAGE_STARTED_SECONDS))" \
        "$((SECONDS - DEPLOY_STARTED_SECONDS))" "$unit" \
        "${previous_invocation:-none}" "${invocation:-none}" "${job:-none}"
      next_report=$((SECONDS + 16))
    fi
    sleep 1
  done
}

start_unit_and_wait() {
  local unit=$1
  local phase=$2
  local timeout_seconds=$3
  local allowed_statuses=${4:-0}
  local previous_invocation invocation_timeout expected_invocation
  stage_start "$phase"
  previous_invocation=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  systemctl start --no-block "$unit"
  invocation_timeout=$timeout_seconds
  if (( invocation_timeout > 120 )); then
    invocation_timeout=120
  fi
  wait_for_new_unit_invocation "$unit" "$previous_invocation" "$invocation_timeout"
  expected_invocation=$NEW_INVOCATION_ID
  wait_for_unit_completion "$unit" "$phase" "$timeout_seconds" \
    "$allowed_statuses" "$expected_invocation" 1
}

start_search_and_wait_for_lock() {
  local unit=quantos-l2@ashare_alpha_search_worker.service
  local deadline active result main_pid previous_invocation invocation
  stage_start ashare_search_start_and_lock
  previous_invocation=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  systemctl start --no-block "$unit"
  wait_for_new_unit_invocation "$unit" "$previous_invocation" 120
  ASHARE_SEARCH_INVOCATION_ID=$NEW_INVOCATION_ID
  deadline=$((SECONDS + 120))
  while (( SECONDS < deadline )); do
    invocation=$(systemctl show "$unit" -p InvocationID --value 2>/dev/null || true)
    if [[ "$invocation" != "$ASHARE_SEARCH_INVOCATION_ID" ]]; then
      die "A-share search invocation changed before lock proof: expected=$ASHARE_SEARCH_INVOCATION_ID observed=$invocation"
      return 1
    fi
    active=$(systemctl show "$unit" -p ActiveState --value 2>/dev/null || true)
    if [[ "$active" != active && "$active" != activating ]]; then
      result=$(systemctl show "$unit" -p Result --value 2>/dev/null || true)
      die "A-share search exited before acquiring the runtime lock: result=$result"
      return 1
    fi
    # ActiveState=activating and a globally busy lock are both insufficient:
    # an old runner or a manual process could own the same inode.  Require the
    # exact MainPID of this freshly started systemd unit to be the FLOCK owner.
    main_pid=$(systemctl show "$unit" -p MainPID --value 2>/dev/null || true)
    if [[ "$main_pid" =~ ^[1-9][0-9]*$ \
      && -f "$ALPHA_RUNTIME_LOCK" && ! -L "$ALPHA_RUNTIME_LOCK" ]]; then
      if lslocks --pid "$main_pid" --noheadings --raw --notruncate \
        --output PID,TYPE,PATH 2>/dev/null \
        | awk -v pid="$main_pid" -v path="$ALPHA_RUNTIME_LOCK" \
          '$1 == pid && $2 == "FLOCK" && $3 == path { found=1 } END { exit !found }'; then
        stage_pass search_active_and_runtime_lock_held
        return 0
      fi
    fi
    sleep 1
  done
  die 'A-share search did not acquire the shared runtime lock within 120 seconds'
}

snapshot_runtime() {
  local unit path
  PREVIOUS_ENABLED_TIMERS=()
  PREVIOUS_ACTIVE_TIMERS=()
  PREVIOUS_ACTIVE_RESIDENTS=()
  PREVIOUS_ENABLED_RESIDENTS=()
  ROLLBACK_ROOT=$(mktemp -d "/var/lib/quantos-deploy/rollback-${RELEASE_COMMIT:0:8}-XXXXXXXX")
  chmod 0700 "$ROLLBACK_ROOT"
  mkdir -m 0700 "$ROLLBACK_ROOT/units" "$ROLLBACK_ROOT/absent"
  for unit in "${ALL_SWITCH_UNITS[@]}"; do
    path="$UNIT_ROOT/$unit"
    if [[ -e "$path" || -L "$path" ]]; then
      cp -a -- "$path" "$ROLLBACK_ROOT/units/$unit"
    else
      : >"$ROLLBACK_ROOT/absent/$unit"
    fi
  done
  for unit in "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer; do
    if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
      PREVIOUS_ENABLED_TIMERS+=("$unit")
    fi
    if systemctl is-active --quiet "$unit" 2>/dev/null; then
      PREVIOUS_ACTIVE_TIMERS+=("$unit")
    fi
  done
  for unit in "${RESIDENT_UNITS[@]}"; do
    if systemctl is-active --quiet "$unit" 2>/dev/null; then
      PREVIOUS_ACTIVE_RESIDENTS+=("$unit")
    fi
    if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
      PREVIOUS_ENABLED_RESIDENTS+=("$unit")
    fi
  done
}

snapshot_alpha_runtime() {
  local name path
  mkdir -m 0700 "$ROLLBACK_ROOT/alpha-runtime" \
    "$ROLLBACK_ROOT/alpha-runtime-absent"
  for name in "${ALPHA_RUNTIME_ARTIFACTS[@]}"; do
    path="$STATE_ROOT/data/cache/$name"
    if [[ -e "$path" || -L "$path" ]]; then
      [[ -f "$path" && ! -L "$path" ]] \
        || die "A-share runtime artifact is unsafe: $name"
      cp --preserve=all -- "$path" "$ROLLBACK_ROOT/alpha-runtime/$name"
    else
      : >"$ROLLBACK_ROOT/alpha-runtime-absent/$name"
    fi
  done
  ALPHA_RUNTIME_SNAPSHOTTED=1
}

restore_alpha_runtime() {
  local name path rc=0
  (( ALPHA_RUNTIME_SNAPSHOTTED == 1 )) || return 0
  for name in "${ALPHA_RUNTIME_ARTIFACTS[@]}"; do
    path="$STATE_ROOT/data/cache/$name"
    if ! rm -f -- "$path"; then
      rc=1
      continue
    fi
    if [[ -f "$ROLLBACK_ROOT/alpha-runtime/$name" ]]; then
      cp --preserve=all -- "$ROLLBACK_ROOT/alpha-runtime/$name" "$path" || rc=1
      cmp -s -- "$ROLLBACK_ROOT/alpha-runtime/$name" "$path" || rc=1
    elif [[ -e "$path" || -L "$path" ]]; then
      rc=1
    fi
  done
  return "$rc"
}

restore_units() {
  local unit path rc=0 expected_enabled
  for unit in "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer; do
    if unit_loaded "$unit"; then
      systemctl disable "$unit" >/dev/null 2>&1 || rc=1
    fi
  done
  for unit in "${RESIDENT_UNITS[@]}"; do
    if unit_loaded "$unit"; then
      systemctl disable "$unit" >/dev/null 2>&1 || rc=1
    fi
  done
  for unit in "${ALL_SWITCH_UNITS[@]}"; do
    path="$UNIT_ROOT/$unit"
    if ! rm -f -- "$path"; then
      rc=1
      continue
    fi
    if [[ -e "$ROLLBACK_ROOT/units/$unit" || -L "$ROLLBACK_ROOT/units/$unit" ]]; then
      cp -a -- "$ROLLBACK_ROOT/units/$unit" "$path" || rc=1
      cmp -s -- "$ROLLBACK_ROOT/units/$unit" "$path" || rc=1
    elif [[ -e "$path" || -L "$path" ]]; then
      rc=1
    fi
  done
  systemctl daemon-reload || rc=1
  for unit in "${ALL_SWITCH_UNITS[@]}"; do
    systemctl reset-failed "$unit" >/dev/null 2>&1 || true
  done
  if ((${#PREVIOUS_ENABLED_TIMERS[@]})); then
    systemctl enable "${PREVIOUS_ENABLED_TIMERS[@]}" >/dev/null || rc=1
  fi
  if ((${#PREVIOUS_ENABLED_RESIDENTS[@]})); then
    systemctl enable "${PREVIOUS_ENABLED_RESIDENTS[@]}" >/dev/null || rc=1
  fi
  if ((${#PREVIOUS_ACTIVE_TIMERS[@]})); then
    systemctl start "${PREVIOUS_ACTIVE_TIMERS[@]}" >/dev/null || rc=1
  fi
  if ((${#PREVIOUS_ACTIVE_RESIDENTS[@]})); then
    systemctl start "${PREVIOUS_ACTIVE_RESIDENTS[@]}" >/dev/null || rc=1
  fi
  for unit in "${RESIDENT_UNITS[@]}"; do
    expected_enabled=0
    for path in "${PREVIOUS_ENABLED_RESIDENTS[@]}"; do
      [[ "$path" == "$unit" ]] && expected_enabled=1
    done
    if (( expected_enabled == 1 )); then
      systemctl is-enabled --quiet "$unit" || rc=1
    elif systemctl is-enabled --quiet "$unit" 2>/dev/null; then
      rc=1
    fi
  done
  return "$rc"
}

cleanup_tmp() {
  # Cleanup is best-effort, but its relaxed error mode must never leak into the
  # deployment shell.  In particular, post-commit health failures rely on
  # errexit to reach recover_post_commit_schedulers_on_exit.
  (
    set +e
    if [[ -n "$CLONE_TMP" && -d "$CLONE_TMP" \
      && "$CLONE_TMP" == /opt/quantos/releases/.quantos-arm64-clone-* ]]; then
      rm -rf -- "$CLONE_TMP"
    fi
    if [[ -n "$TRUSTED_PACKAGE_TMP" && -d "$TRUSTED_PACKAGE_TMP" \
      && "$TRUSTED_PACKAGE_TMP" == /var/lib/quantos-deploy/packages/.package-$RELEASE_COMMIT-* ]]; then
      rm -rf -- "$TRUSTED_PACKAGE_TMP"
    fi
    if (( PAIR_REPLACED == 0 )) && [[ -n "$TDX_PAIR_STAGE" \
      && -d "$TDX_PAIR_STAGE" && ! -L "$TDX_PAIR_STAGE" \
      && "$TDX_PAIR_STAGE" == "$TDX_STATE_PARENT/.tdx-generation-$RELEASE_COMMIT-"* ]]; then
      rm -rf -- "$TDX_PAIR_STAGE"
    fi
    exit 0
  )
}

recover_post_commit_schedulers_on_exit() {
  local original_rc=$?
  local unit recovery_rc=0
  trap - EXIT
  set +Eeuo pipefail
  if (( original_rc == 0 )); then
    exit 0
  fi
  printf 'POST_COMMIT_TIMER_RECOVERY_START original_rc=%s stage=%s\n' \
    "$original_rc" "$CURRENT_STAGE" >&2
  systemctl start "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer \
    >/dev/null 2>&1 || recovery_rc=1
  for unit in "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer; do
    if ! systemctl is-active --quiet "$unit"; then
      printf 'POST_COMMIT_TIMER_RECOVERY_UNIT_FAILURE unit=%s\n' "$unit" >&2
      recovery_rc=1
    fi
  done
  if (( recovery_rc == 0 )); then
    printf 'POST_COMMIT_TIMER_RECOVERY_PASS original_rc=%s\n' \
      "$original_rc" >&2
  else
    printf 'POST_COMMIT_TIMER_RECOVERY_FAILURE original_rc=%s\n' \
      "$original_rc" >&2
  fi
  exit "$original_rc"
}

rollback() {
  local rc=${1:-1}
  local unit rollback_rc=0 drained=1
  trap - EXIT
  set +Eeuo pipefail
  printf 'DEPLOY_FAILURE rc=%s switch_started=%s stage=%s elapsed=%ss\n' \
    "$rc" "$SWITCH_STARTED" "$CURRENT_STAGE" \
    "$((SECONDS - DEPLOY_STARTED_SECONDS))" >&2
  if (( SWITCH_STARTED == 1 )); then
    stop_known_timers >/dev/null 2>&1 || rollback_rc=1
    stop_loaded_units_no_block "${RESIDENT_UNITS[@]}" >/dev/null 2>&1 \
      || rollback_rc=1
    if ! wait_for_units_inactive 180 "${RESIDENT_UNITS[@]}"; then
      rollback_rc=1
      drained=0
    fi
    # Never terminate an in-flight backup, data worker, or search.  Full
    # rollback waits for the reviewed systemd timeout instead.
    if ! wait_for_workers_to_drain rollback_worker_drain 7300; then
      rollback_rc=1
      drained=0
    fi
    if (( drained == 1 )); then
      restore_alpha_runtime || rollback_rc=1
      if (( PAIR_REPLACED == 1 )); then
        if [[ -d "$TDX_STATE_DIR" && ! -L "$TDX_STATE_DIR" \
          && -d "$PAIR_ROLLBACK_DIR" && ! -L "$PAIR_ROLLBACK_DIR" ]]; then
          exchange_directories "$TDX_STATE_DIR" "$PAIR_ROLLBACK_DIR" \
            || rollback_rc=1
          sync -f "$TDX_STATE_PARENT" || rollback_rc=1
        else
          rollback_rc=1
        fi
      fi
      if [[ -n "$current_sqlite_hash" ]]; then
        [[ -f "$TDX_SQLITE" && ! -L "$TDX_SQLITE" \
          && $(sha256sum "$TDX_SQLITE" | awk '{print $1}') == "$current_sqlite_hash" ]] \
          || rollback_rc=1
      elif [[ -e "$TDX_SQLITE" || -L "$TDX_SQLITE" ]]; then
        rollback_rc=1
      fi
      if [[ -n "$current_panel_hash" ]]; then
        [[ -f "$TDX_PANEL" && ! -L "$TDX_PANEL" \
          && $(sha256sum "$TDX_PANEL" | awk '{print $1}') == "$current_panel_hash" ]] \
          || rollback_rc=1
      elif [[ -e "$TDX_PANEL" || -L "$TDX_PANEL" ]]; then
        rollback_rc=1
      fi
      restore_units || rollback_rc=1
      systemctl restart quantos-proxy-environment.service >/dev/null 2>&1 \
        || rollback_rc=1
    fi
    release_alpha_deploy_lock || rollback_rc=1
    if (( rollback_rc == 0 )); then
      printf 'DEPLOY_ROLLBACK_PASS rollback=%s data_pair_restored=%s\n' \
        "$ROLLBACK_ROOT" "$PAIR_REPLACED" >&2
    else
      printf 'DEPLOY_ROLLBACK_FAILURE rollback=%s drained=%s data_pair_restored=%s\n' \
        "$ROLLBACK_ROOT" "$drained" "$PAIR_REPLACED" >&2
    fi
  fi
  cleanup_tmp
  exit "$rc"
}

on_exit() {
  local rc=$?
  if (( SUCCESS == 0 )); then
    rollback "$rc"
  fi
  cleanup_tmp
  exit "$rc"
}
trap on_exit EXIT

[[ ${EUID:-$(id -u)} -eq 0 ]] || die 'run with sudo'
DEPLOY_LOCK=/run/lock/quantos-arm64-deploy.lock
if [[ -e "$DEPLOY_LOCK" || -L "$DEPLOY_LOCK" ]]; then
  [[ -f "$DEPLOY_LOCK" && ! -L "$DEPLOY_LOCK" \
    && $(stat -c '%u:%g:%a' "$DEPLOY_LOCK") == 0:0:600 ]] \
    || die 'global deploy lock path is unsafe'
else
  install -o root -g root -m 0600 /dev/null "$DEPLOY_LOCK"
fi
exec {DEPLOY_LOCK_FD}>>"$DEPLOY_LOCK"
flock -n "$DEPLOY_LOCK_FD" \
  || die 'another native ARM64 deployment is already active'
stage_start native_arm64_and_package_preflight
[[ $(uname -m) == aarch64 ]] || die 'host architecture is not native aarch64'
[[ -d /run/systemd/system ]] || die 'systemd is unavailable'
for command in flock git lslocks runuser sha256sum systemctl systemd-analyze timeout; do
  command -v "$command" >/dev/null || die "$command is unavailable"
done
[[ -d "$PACKAGE_DIR" && ! -L "$PACKAGE_DIR" ]] || die 'package root is unsafe'
[[ -f "$BUNDLE" && ! -L "$BUNDLE" ]] || die 'release bundle is unsafe'
[[ $(sha256sum "$BUNDLE" | awk '{print $1}') == "$BUNDLE_SHA256" ]] \
  || die 'release bundle hash mismatch'

read -r -d '' PACKAGE_VERIFY_CODE <<'PY' || true
import hashlib
import json
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
def unique(pairs):
    out = {}
    for key, value in pairs:
        if key in out:
            raise SystemExit("duplicate manifest key")
        out[key] = value
    return out
manifest = json.loads(
    (root / "PACKAGE_MANIFEST.json").read_text(encoding="utf-8"),
    object_pairs_hook=unique,
)
if (
    manifest.get("schema") != "quantos.arm64_release_package.v1"
    or manifest.get("architecture") != "linux/arm64"
    or manifest.get("readiness") != "L2_DRY_RUN_ONLY"
    or manifest.get("release", {}).get("commit") != sys.argv[2]
):
    raise SystemExit("package identity contract failed")
listed = {}
for line in (root / "SHA256SUMS").read_text(encoding="utf-8").splitlines():
    digest, separator, name = line.partition("  ")
    if not separator or len(digest) != 64 or name in listed:
        raise SystemExit("malformed SHA256SUMS")
    listed[name] = digest
actual = {}
for path in sorted(root.rglob("*")):
    metadata = path.lstat()
    if stat.S_ISLNK(metadata.st_mode):
        raise SystemExit("package contains a symlink")
    if stat.S_ISDIR(metadata.st_mode):
        continue
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit("package contains a non-regular file")
    relative = path.relative_to(root).as_posix()
    if relative != "SHA256SUMS":
        actual[relative] = hashlib.sha256(path.read_bytes()).hexdigest()
if actual != listed:
    raise SystemExit("package exact hash set failed")
PY
/usr/bin/python3 -P -c "$PACKAGE_VERIFY_CODE" "$PACKAGE_DIR" "$RELEASE_COMMIT"

# Pin every later package read to one root-owned snapshot.  The package passed
# to sudo normally lives in a user-writable staging tree; using it after a long
# worker drain would leave a verification-to-install race.  The source remains
# useful only long enough to create and verify this immutable local snapshot.
SOURCE_PACKAGE_DIR=$PACKAGE_DIR
SOURCE_PACKAGE_INDEX_SHA256=$(sha256sum "$SOURCE_PACKAGE_DIR/SHA256SUMS" | awk '{print $1}')
TRUSTED_PACKAGE_PARENT=/var/lib/quantos-deploy/packages
TRUSTED_PACKAGE_DIR="$TRUSTED_PACKAGE_PARENT/$RELEASE_COMMIT"
install -d -o root -g root -m 0700 /var/lib/quantos-deploy "$TRUSTED_PACKAGE_PARENT"
if [[ -e "$TRUSTED_PACKAGE_DIR" || -L "$TRUSTED_PACKAGE_DIR" ]]; then
  [[ -d "$TRUSTED_PACKAGE_DIR" && ! -L "$TRUSTED_PACKAGE_DIR" ]] \
    || die 'trusted package snapshot path is unsafe'
else
  TRUSTED_PACKAGE_TMP=$(mktemp -d \
    "$TRUSTED_PACKAGE_PARENT/.package-$RELEASE_COMMIT-XXXXXXXX")
  cp -a -- "$SOURCE_PACKAGE_DIR/." "$TRUSTED_PACKAGE_TMP/"
  chown -R root:root "$TRUSTED_PACKAGE_TMP"
  chmod -R u=rwX,go= "$TRUSTED_PACKAGE_TMP"
  /usr/bin/python3 -P -c "$PACKAGE_VERIFY_CODE" \
    "$TRUSTED_PACKAGE_TMP" "$RELEASE_COMMIT"
  [[ $(sha256sum "$TRUSTED_PACKAGE_TMP/SHA256SUMS" | awk '{print $1}') \
    == "$SOURCE_PACKAGE_INDEX_SHA256" ]] \
    || die 'trusted package snapshot index drifted during copy'
  mv -- "$TRUSTED_PACKAGE_TMP" "$TRUSTED_PACKAGE_DIR"
  TRUSTED_PACKAGE_TMP=''
fi
[[ -z $(find "$TRUSTED_PACKAGE_DIR" \
  \( ! -user root -o ! -group root -o -perm /022 \) -print -quit) ]] \
  || die 'trusted package snapshot ownership or mode drifted'
[[ $(sha256sum "$TRUSTED_PACKAGE_DIR/SHA256SUMS" | awk '{print $1}') \
  == "$SOURCE_PACKAGE_INDEX_SHA256" ]] \
  || die 'existing trusted package snapshot differs from the submitted package'
/usr/bin/python3 -P -c "$PACKAGE_VERIFY_CODE" \
  "$TRUSTED_PACKAGE_DIR" "$RELEASE_COMMIT"
PACKAGE_DIR=$TRUSTED_PACKAGE_DIR
BUNDLE="$PACKAGE_DIR/$BUNDLE_NAME"
[[ $(sha256sum "$BUNDLE" | awk '{print $1}') == "$BUNDLE_SHA256" ]] \
  || die 'trusted release bundle hash mismatch'

git -C "$BASELINE_ROOT" bundle verify "$BUNDLE" >/dev/null
[[ -d "$STATE_ROOT" && ! -L "$STATE_ROOT" ]] || die 'state root is unsafe'
[[ $(stat -c '%U:%G' "$STATE_ROOT") == quantos:quantos ]] \
  || die 'state root ownership drifted'
[[ -d "$BASE_VENV" && ! -L "$BASE_VENV" && -x "$BASE_VENV/bin/python" ]] \
  || die 'native base venv is unavailable'
"$BASE_VENV/bin/python" -P -c \
  'import platform; assert platform.machine().lower() in {"aarch64", "arm64"}'
[[ -d "$BASELINE_ROOT" && ! -L "$BASELINE_ROOT" ]] \
  || die 'rollback baseline release is unavailable'
[[ $(git -C "$BASELINE_ROOT" rev-parse HEAD) == "$BASELINE_COMMIT" ]] \
  || die 'rollback baseline release identity drifted'
[[ -z $(git -C "$BASELINE_ROOT" status --porcelain=v1 --untracked-files=all --ignore-submodules=none) ]] \
  || die 'rollback baseline release is dirty'
for source in "$TDX_SQLITE_SOURCE" "$TDX_PANEL_SOURCE"; do
  [[ -f "$source" && ! -L "$source" ]] || die "TDX source is unsafe: $source"
done
[[ $(sha256sum "$TDX_SQLITE_SOURCE" | awk '{print $1}') == "$TDX_SQLITE_SHA256" ]] \
  || die 'TDX SQLite source hash drifted'
[[ $(sha256sum "$TDX_PANEL_SOURCE" | awk '{print $1}') == "$TDX_PANEL_SHA256" ]] \
  || die 'TDX panel source hash drifted'
stage_pass root_owned_package_commit_arm64_and_external_hashes_verified

stage_start release_frontend_and_token_install
install -d -o root -g root -m 0755 \
  /opt/quantos/releases /opt/quantos/venvs /opt/quantos/frontend
if [[ -e "$RELEASE" || -L "$RELEASE" ]]; then
  [[ -d "$RELEASE" && ! -L "$RELEASE" ]] || die 'release path is unsafe'
  [[ $(git -C "$RELEASE" rev-parse HEAD) == "$RELEASE_COMMIT" ]] \
    || die 'installed release identity mismatch'
else
  CLONE_TMP=$(mktemp -d /opt/quantos/releases/.quantos-arm64-clone-XXXXXXXX)
  git clone --quiet --no-checkout "$BUNDLE" "$CLONE_TMP"
  git -C "$CLONE_TMP" checkout --quiet --detach "$RELEASE_COMMIT"
  chown -R root:root "$CLONE_TMP"
  chmod -R u+rwX,go+rX,go-w "$CLONE_TMP"
