else
  install -d -o root -g root -m 0755 "$FRONTEND"
  cp -a -- "$PACKAGE_DIR/frontend/." "$FRONTEND/"
  chown -R root:root "$FRONTEND"
  find "$FRONTEND" -type d -exec chmod 0755 {} +
  find "$FRONTEND" -type f -exec chmod 0644 {} +
fi
read -r -d '' TREE_HASH_CODE <<'PY' || true
import hashlib
import json
import stat
import sys
from pathlib import Path
root = Path(sys.argv[1])
rows = {}
for path in sorted(root.rglob("*")):
    metadata = path.lstat()
    if stat.S_ISLNK(metadata.st_mode):
        raise SystemExit("tree symlink")
    if stat.S_ISDIR(metadata.st_mode):
        continue
    if not stat.S_ISREG(metadata.st_mode):
        raise SystemExit("tree non-regular")
    rows[path.relative_to(root).as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()
encoded = json.dumps(rows, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
print(hashlib.sha256(encoded).hexdigest())
PY
[[ $(/usr/bin/python3 -P -c "$TREE_HASH_CODE" "$FRONTEND") == "$FRONTEND_TREE_SHA256" ]] \
  || die 'installed frontend tree hash drifted'

install -d -o quantos -g quantos -m 0700 \
  "$STATE_ROOT/key" "$STATE_ROOT/.runtime"
RUNNER_TOKEN="$STATE_ROOT/key/research_runner_token.txt"
if [[ -e "$RUNNER_TOKEN" || -L "$RUNNER_TOKEN" ]]; then
  [[ -f "$RUNNER_TOKEN" && ! -L "$RUNNER_TOKEN" ]] \
    || die 'runner token path is not a safe regular file'
  [[ $(stat -c '%s' "$RUNNER_TOKEN") -ge 32 ]] \
    || die 'runner token is unexpectedly short'
  # Normalize only metadata on an already-safe file.  Its contents are never
  # read, replaced, printed, or passed on a command line.
  chown quantos:quantos "$RUNNER_TOKEN"
  chmod 0600 "$RUNNER_TOKEN"
fi
read -r -d '' TOKEN_CODE <<'PY' || true
import os
import secrets
import stat
import sys
from pathlib import Path
path = Path(sys.argv[1])
try:
    metadata = path.lstat()
except FileNotFoundError:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        os.write(fd, (secrets.token_urlsafe(48) + "\n").encode("ascii"))
        os.fsync(fd)
    finally:
        os.close(fd)
else:
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_mode & 0o077:
        raise SystemExit("runner token is not a private regular file")
    if metadata.st_uid != os.getuid() or path.stat().st_size < 32:
        raise SystemExit("runner token ownership/content contract failed")
PY
runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
  /usr/bin/python3 -P -c "$TOKEN_CODE" \
  "$RUNNER_TOKEN"
stage_pass immutable_release_frontend_and_private_runner_token_ready

stage_start tdx_v2_pair_stage_verify
install -d -o quantos -g quantos -m 0750 "$TDX_STATE_PARENT"
if [[ -e "$TDX_STATE_DIR" || -L "$TDX_STATE_DIR" ]]; then
  [[ -d "$TDX_STATE_DIR" && ! -L "$TDX_STATE_DIR" ]] \
    || die 'canonical TDX generation is not a real directory'
else
  install -d -o quantos -g quantos -m 0750 "$TDX_STATE_DIR"
fi
if [[ -e "$TDX_SQLITE" || -L "$TDX_SQLITE" \
  || -e "$TDX_PANEL" || -L "$TDX_PANEL" ]]; then
  [[ -f "$TDX_SQLITE" && ! -L "$TDX_SQLITE" \
    && -f "$TDX_PANEL" && ! -L "$TDX_PANEL" ]] \
    || die 'canonical TDX generation contains a partial or unsafe pair'
fi
current_sqlite_hash=''
current_panel_hash=''
if [[ -f "$TDX_SQLITE" && ! -L "$TDX_SQLITE" ]]; then
  current_sqlite_hash=$(sha256sum "$TDX_SQLITE" | awk '{print $1}')
fi
if [[ -f "$TDX_PANEL" && ! -L "$TDX_PANEL" ]]; then
  current_panel_hash=$(sha256sum "$TDX_PANEL" | awk '{print $1}')
fi
if [[ "$current_sqlite_hash" != "$TDX_SQLITE_SHA256" \
  || "$current_panel_hash" != "$TDX_PANEL_SHA256" ]]; then
  PAIR_NEEDS_REPLACE=1
  TDX_PAIR_STAGE="$TDX_STATE_PARENT/.tdx-generation-$RELEASE_COMMIT-$$"
  [[ ! -e "$TDX_PAIR_STAGE" && ! -L "$TDX_PAIR_STAGE" ]] \
    || die 'TDX generation staging path already exists'
  install -d -o quantos -g quantos -m 0750 "$TDX_PAIR_STAGE"
  SQLITE_INCOMING="$TDX_PAIR_STAGE/ashare_tdx_pit.sqlite"
  PANEL_INCOMING="$TDX_PAIR_STAGE/ashare_tdx_pit.adv20000000.panel.npz"
  install -o quantos -g quantos -m 0640 "$TDX_SQLITE_SOURCE" "$SQLITE_INCOMING"
  install -o quantos -g quantos -m 0640 "$TDX_PANEL_SOURCE" "$PANEL_INCOMING"
  sync -f "$SQLITE_INCOMING"
  sync -f "$PANEL_INCOMING"
  sync -f "$TDX_PAIR_STAGE"
  sync -f "$TDX_STATE_PARENT"
else
  SQLITE_INCOMING=$TDX_SQLITE
  PANEL_INCOMING=$TDX_PANEL
fi
read -r -d '' TDX_VERIFY_CODE <<'PY' || true
import hashlib
import sqlite3
import sys
from pathlib import Path
import numpy as np
database, panel = map(Path, sys.argv[1:3])
expected_sha, panel_sha = sys.argv[3:5]
expected = tuple(map(int, sys.argv[5:10]))
def sha(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()
if sha(database) != expected_sha or sha(panel) != panel_sha:
    raise SystemExit("TDX pair hash mismatch")
connection = sqlite3.connect(f"file:{database.resolve()}?mode=ro&immutable=1", uri=True)
try:
    if connection.execute("PRAGMA quick_check").fetchone() != ("ok",):
        raise SystemExit("TDX quick_check failed")
    if connection.execute("PRAGMA user_version").fetchone()[0] != 2:
        raise SystemExit("TDX schema is not v2")
    observed = connection.execute(
        "SELECT count(*),count(DISTINCT instrument),count(DISTINCT trade_date),"
        "min(trade_date),max(trade_date) FROM daily_prices"
    ).fetchone()
    future = connection.execute(
        "SELECT count(*) FROM daily_prices WHERE knowledge_time>trade_date"
    ).fetchone()[0]
    tables = {row[0] for row in connection.execute(
        "SELECT name FROM sqlite_master WHERE type='table'"
    )}
finally:
    connection.close()
required = {"source_captures", "universe_snapshots", "security_master_snapshots",
            "fundamental_snapshots", "industry_snapshots",
            "current_business_snapshots", "opaque_source_snapshots"}
if observed != expected or future != 0 or not required <= tables:
    raise SystemExit(f"TDX semantic contract failed: {observed!r}")
with np.load(panel, allow_pickle=False) as payload:
    if str(payload["db_sha256"].item()) != expected_sha:
        raise SystemExit("TDX panel database binding failed")
    if float(payload["min_adv_cny"].item()) != 20_000_000.0:
        raise SystemExit("TDX panel ADV contract failed")
PY
runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
  "$VENV/bin/python" -P -c "$TDX_VERIFY_CODE" \
  "$SQLITE_INCOMING" "$PANEL_INCOMING" \
  "$TDX_SQLITE_SHA256" "$TDX_PANEL_SHA256" \
  "$TDX_SQLITE_ROWS" "$TDX_INSTRUMENTS" "$TDX_DATES" \
  "$TDX_FIRST_DATE" "$TDX_LAST_DATE"
stage_pass incoming_pair_hash_quick_check_schema_panel_binding_pass

stage_start systemd_render_verify_and_snapshot
install -d -o root -g root -m 0700 /var/lib/quantos-deploy
for unit in "${SUPPORT_UNITS[@]}"; do
  if unit_loaded "$unit"; then
    assert_no_unit_dropins "$unit"
  fi
done
for unit in "${SUPPORT_UNITS[@]}"; do
  [[ -f "$PACKAGE_DIR/units/support/$unit" \
    && ! -L "$PACKAGE_DIR/units/support/$unit" ]] \
    || die "package support unit is missing or unsafe: $unit"
done
systemd-analyze verify \
  "$PACKAGE_DIR"/units/workers/* \
  "$PACKAGE_DIR"/units/special/* \
  "$PACKAGE_DIR"/units/support/*
snapshot_runtime
stage_pass rendered_units_verified_and_runtime_snapshotted

stage_start scheduler_quiesce_and_worker_drain
SWITCH_STARTED=1
stop_known_timers
wait_for_workers_to_drain pre_cutover_worker_drain 7300
stop_residents_and_verify resident_reader_writer_quiesce 180
acquire_alpha_deploy_lock
snapshot_alpha_runtime
stage_pass readers_and_schedulers_quiesced

if (( PAIR_NEEDS_REPLACE == 1 )); then
  stage_start tdx_existing_forward_prefix_compatibility
  runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
    PYTHONPATH="$RELEASE" QUANTOS_RELEASE_ROOT="$RELEASE" \
    QUANTOS_RELEASE_COMMIT="$RELEASE_COMMIT" QUANTOS_STATE_ROOT="$STATE_ROOT" \
    "$VENV/bin/python" -P - "$SQLITE_INCOMING" \
    "$STATE_ROOT/data/cache/ashare_forward_freeze.json" <<'PY'
import sys
from pathlib import Path

from tools.ashare_alpha_search_worker import (
    _read_object,
    _source_prefix_bindings,
    _validate_freeze_document,
    _validate_frozen_search_artifact,
)

database, freeze_path = map(Path, sys.argv[1:3])
if not freeze_path.exists():
    print("ASHARE_FORWARD_PREFIX_COMPATIBILITY_PASS mode=NO_EXISTING_FREEZE")
    raise SystemExit(0)
if not freeze_path.is_file() or freeze_path.is_symlink():
    raise SystemExit("existing A-share forward freeze path is unsafe")
freeze = _read_object(freeze_path)
_validate_freeze_document(freeze)
_validate_frozen_search_artifact(freeze, freeze_path)
cutoff = int(freeze["freeze_cutoff"])
observed = _source_prefix_bindings(database, [cutoff])[cutoff]
if observed != freeze["source_prefix"]:
    raise SystemExit(
        "incoming TDX database revises the immutable forward prefix; "
        "canonical generation was not changed"
    )
print(f"ASHARE_FORWARD_PREFIX_COMPATIBILITY_PASS cutoff={cutoff} rows={observed['rows']}")
PY
  stage_pass incoming_database_preserves_existing_untouched_forward_prefix

  stage_start tdx_pair_publish
  [[ -d "$TDX_PAIR_STAGE" && ! -L "$TDX_PAIR_STAGE" ]] \
    || die 'verified TDX generation staging directory disappeared'
  # Both large files were completed and fsynced in the sibling generation.
  # One renameat2(RENAME_EXCHANGE) now publishes the pair as a single namespace
  # operation.  SIGKILL/power loss can expose either generation, never a mix.
  exchange_directories "$TDX_STATE_DIR" "$TDX_PAIR_STAGE"
  PAIR_ROLLBACK_DIR=$TDX_PAIR_STAGE
  PAIR_REPLACED=1
  sync -f "$TDX_STATE_PARENT"
  runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
    "$VENV/bin/python" -P -c "$TDX_VERIFY_CODE" \
    "$TDX_SQLITE" "$TDX_PANEL" "$TDX_SQLITE_SHA256" "$TDX_PANEL_SHA256" \
    "$TDX_SQLITE_ROWS" "$TDX_INSTRUMENTS" "$TDX_DATES" \
    "$TDX_FIRST_DATE" "$TDX_LAST_DATE"
  stage_pass canonical_generation_atomically_exchanged_with_retained_rollback
fi

stage_start systemd_unit_cutover
UNITS_REPLACED=1
for source in \
  "$PACKAGE_DIR"/units/workers/* \
  "$PACKAGE_DIR"/units/special/* \
  "$PACKAGE_DIR"/units/support/*; do
  target="$UNIT_ROOT/${source##*/}"
  rm -f -- "$target"
  install -o root -g root -m 0644 -- "$source" "$target"
done
systemctl daemon-reload
for unit in "${ALL_SWITCH_UNITS[@]}"; do
  systemctl reset-failed "$unit" >/dev/null 2>&1 || true
done
for unit in "${SUPPORT_UNITS[@]}"; do
  assert_no_unit_dropins "$unit"
  [[ $(systemctl show "$unit" -p FragmentPath --value) == "$UNIT_ROOT/$unit" ]] \
    || die "support unit fragment path drifted: $unit"
done
systemctl restart quantos-proxy-environment.service
systemctl enable "${RESIDENT_UNITS[@]}" >/dev/null
stage_pass release_bound_units_installed

read -r -d '' RESIDENT_RECEIPT_CODE <<'PY' || true
import json
import re
import sys
import time
from pathlib import Path
try:
    value = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)
now = int(time.time() * 1000)
safety = value.get("safety")
healthy = (
    isinstance(value.get("generated_at_ms"), int)
    and 0 <= now - value["generated_at_ms"] <= 60_000
    and value.get("verdict") == "PASS"
    and value.get("streaming") is True
    and isinstance(safety, dict)
    and all(safety.get(key) is False for key in
            ("credentials", "private_stream", "broker_connectivity",
             "order_submission", "live_trading"))
)
if sys.argv[2] == "BINANCE":
    store = value.get("store")
    cursor = value.get("cursor")
    healthy = healthy and isinstance(store, dict) and store.get("chain_valid") is True
    healthy = healthy and isinstance(cursor, dict) and cursor.get("publishable") is True
elif sys.argv[2] == "BYBIT":
    resilience = value.get("resilience")
    healthy = healthy and isinstance(resilience, dict)
    healthy = healthy and resilience.get("chain_valid") is True
    healthy = healthy and isinstance(resilience.get("head_hash"), str)
    healthy = healthy and re.fullmatch(r"[0-9a-f]{64}", resilience["head_hash"]) is not None
raise SystemExit(0 if healthy else 1)
PY

http_ok() {
  "$VENV/bin/python" -P -c \
    'import sys,urllib.request; r=urllib.request.urlopen(sys.argv[1],timeout=3); assert r.status==200' \
    "$1" >/dev/null 2>&1
}

runner_ok() {
  "$VENV/bin/python" -P -c \
    'import json,sys,urllib.request; d=json.load(urllib.request.urlopen("http://127.0.0.1:8420/health",timeout=3)); k=set(d.get("kinds",[])); assert d.get("live_disallowed") is True; assert {"ashare_technical_search","ashare_forward_observation"} <= k; assert not ({"backtest","factory_loop","factory_orthogonal"} & k)' \
    >/dev/null 2>&1
}

stage_start resident_streams_console_and_runner_readiness
systemctl start "${RESIDENT_UNITS[@]}"
ready=0
for attempt in $(seq 1 600); do
  binance=0
  bybit=0
  api=0
  frontend=0
  runner=0
  runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
    "$VENV/bin/python" -P -c "$RESIDENT_RECEIPT_CODE" \
    "$STATE_ROOT/data/cache/binance_realtime_stream_status.json" BINANCE \
    >/dev/null 2>&1 && binance=1 || true
  runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
    "$VENV/bin/python" -P -c "$RESIDENT_RECEIPT_CODE" \
    "$STATE_ROOT/data/cache/bybit_realtime_stream_status.json" BYBIT \
    >/dev/null 2>&1 && bybit=1 || true
  http_ok http://127.0.0.1:8400/health && api=1 || true
  http_ok "$FRONTEND_HEALTH_URL" && frontend=1 || true
  runner_ok && runner=1 || true
  if (( binance && bybit && api && frontend && runner )) \
    && systemctl is-active --quiet quantos-binance-realtime-stream.service \
    && systemctl is-active --quiet quantos-bybit-realtime-stream.service \
    && systemctl is-active --quiet quantos-console-api.service \
    && systemctl is-active --quiet quantos-console-frontend.service \
    && systemctl is-active --quiet quantos-research-runner.service; then
    ready=1
    break
  fi
  if (( attempt == 1 || attempt % 16 == 0 )); then
    printf 'DEPLOY_STAGE_HEARTBEAT stage=%s duration=%ss binance=%s bybit=%s api=%s frontend=%s runner=%s\n' \
      "$CURRENT_STAGE" "$((SECONDS - STAGE_STARTED_SECONDS))" \
      "$binance" "$bybit" "$api" "$frontend" "$runner"
  fi
  sleep 1
done
(( ready == 1 )) || die 'resident streams, console, frontend, or runner did not become ready'
stage_pass official_8400_3100_8420_chain_and_stream_receipts_healthy

stage_start timers_enable_without_activation
systemctl enable "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer >/dev/null
for unit in "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer; do
  systemctl is-enabled --quiet "$unit" || die "timer is not enabled: $unit"
  if systemctl is-active --quiet "$unit" 2>/dev/null; then
    die "timer activated before the infrastructure transaction committed: $unit"
  fi
done
stage_pass worker_and_watchdog_timers_enabled_but_quiescent

stage_start systemd_runtime_contract
runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin PYTHONPATH="$RELEASE" \
  QUANTOS_RELEASE_ROOT="$RELEASE" QUANTOS_RELEASE_COMMIT="$RELEASE_COMMIT" \
  QUANTOS_STATE_ROOT="$STATE_ROOT" \
  "$VENV/bin/python" -P - <<'PY'
from tools.l2_scheduler_watchdog import collect_systemd_units
items = collect_systemd_units()
bad = sorted(item.name for item in items if not item.scheduler_contract_ok)
if bad:
    raise SystemExit(f"SYSTEMD_CONTRACT_FAILED bad={bad}")
print(f"SYSTEMD_CONTRACT_PASS snapshots={len(items)}")
PY
stage_pass installed_scheduler_contract_verified

stage_start post_cutover_health
for unit in "${RESIDENT_UNITS[@]}"; do
  systemctl is-active --quiet "$unit" || die "official resident/support unit is not active: $unit"
  systemctl is-enabled --quiet "$unit" || die "official resident/support unit is not enabled: $unit"
  grep -Fq "$RELEASE_COMMIT" "$UNIT_ROOT/$unit" \
    || die "official unit release binding drifted: $unit"
done
for unit in "${SUPPORT_UNITS[@]}"; do
  assert_no_unit_dropins "$unit"
done
for module in "${FORBIDDEN_MODULES[@]}"; do
  if systemctl is-active --quiet "quantos-l2@$module.service" 2>/dev/null; then
    die "forbidden legacy/V1 worker is active: $module"
  fi
  if systemctl is-enabled --quiet "quantos-l2@$module.timer" 2>/dev/null; then
    die "forbidden legacy/V1 timer is enabled: $module"
  fi
done
stage_pass infrastructure_transaction_healthy

probe_alpha_lock_worker_access
release_alpha_deploy_lock

# The rollback-sensitive transaction is over.  The long technical search may
# now finish without holding unit/data rollback open.  A later research failure
# is reported loudly but does not tear down the already healthy infrastructure.
SUCCESS=1
trap recover_post_commit_schedulers_on_exit EXIT
cleanup_tmp
printf 'DGX_ARM64_INFRASTRUCTURE_DEPLOY_PASS release=%s rollback=%s\n' \
  "$RELEASE_COMMIT" "$ROLLBACK_ROOT"

# Long research and Persistent timer catch-up are deliberately outside the
# rollback-sensitive cutover.  Search takes the shared lock first, so a caught-
# up forward timer can only record SAFE_BLOCKED rather than race the freeze.
start_search_and_wait_for_lock
start_unit_and_wait quantos-l2@ashare_forward_observation.service \
  ashare_forward_initial_safe_history 300 '0 2'

stage_start parallel_worker_timers_activate_post_commit
systemctl start "${EARLY_WORKER_TIMERS[@]}" >/dev/null
for unit in "${EARLY_WORKER_TIMERS[@]}"; do
  systemctl is-active --quiet "$unit" || die "timer is not active: $unit"
done
stage_pass independent_worker_timers_active_while_search_runs

wait_for_unit_completion quantos-l2@ashare_alpha_search_worker.service \
  ashare_search_completion 7200 '0' "$ASHARE_SEARCH_INVOCATION_ID"
start_unit_and_wait quantos-l2@ashare_forward_observation.service \
  ashare_forward_after_search 1800 '0 2'

stage_start ashare_forward_artifact_binding
runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
  "$VENV/bin/python" -P - "$TDX_SQLITE" \
  "$STATE_ROOT/data/cache/ashare_forward_freeze.json" \
  "$STATE_ROOT/data/cache/ashare_forward_observation.db" \
  "$STATE_ROOT/data/cache/ashare_forward_observation.json" <<'PY'
import hashlib
import json
import re
import sqlite3
import sys
from pathlib import Path

database, freeze_path, ledger_path, report_path = map(Path, sys.argv[1:5])
def sha(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()
try:
    freeze = json.loads(freeze_path.read_text(encoding="utf-8"))
    report = json.loads(report_path.read_text(encoding="utf-8"))
except Exception as exc:
    raise SystemExit(f"A-share forward artifact unreadable: {exc}")
database_sha = sha(database)
healthy = (
    report.get("status") in {"ARMED_AWAITING_NEW_SESSIONS", "OBSERVING"}
    and report.get("chain_valid") is True
    and report.get("selection_locked") is True
    and report.get("promotion_allowed") is False
    and report.get("execution_allowed") is False
    and isinstance(report.get("source"), dict)
    and report["source"].get("sha256") == database_sha
    and isinstance(report.get("ledger"), dict)
    and report["ledger"].get("freeze_sha256") == sha(freeze_path)
    and freeze.get("selection_locked") is True
    and freeze.get("promotion_allowed") is False
    and freeze.get("execution_allowed") is False
    and re.fullmatch(r"[0-9a-f]{64}", str(freeze.get("search_artifact_sha256", "")))
)
if not healthy or not ledger_path.is_file():
    raise SystemExit("A-share forward artifact is not bound to canonical state")
connection = sqlite3.connect(f"file:{ledger_path.resolve()}?mode=ro", uri=True)
try:
    if connection.execute("PRAGMA quick_check").fetchone() != ("ok",):
        raise SystemExit("A-share forward ledger quick_check failed")
finally:
    connection.close()
print(f"ASHARE_FORWARD_ARTIFACT_PASS status={report['status']} source={database_sha}")
PY
stage_pass forward_freeze_ledger_report_and_canonical_source_bound

start_unit_and_wait quantos-l2-watchdog.service watchdog_post_search_probe 300 '0 2'

stage_start deferred_observation_timers_activate
systemctl start quantos-l2@ashare_forward_observation.timer \
  quantos-l2-watchdog.timer >/dev/null
systemctl is-active --quiet quantos-l2@ashare_forward_observation.timer \
  || die 'A-share forward-observation timer is not active'
systemctl is-active --quiet quantos-l2-watchdog.timer \
  || die 'watchdog timer is not active'
stage_pass forward_and_watchdog_timers_active_after_exact_probes

stage_start old_user_transient_stop
old_uid=$(id -u kerstker)
old_bus="/run/user/$old_uid/bus"
if [[ -S "$old_bus" ]]; then
  for unit in "${OLD_USER_UNITS[@]}"; do
    runuser -u kerstker -- env \
      XDG_RUNTIME_DIR="/run/user/$old_uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$old_bus" \
      systemctl --user stop "$unit" >/dev/null 2>&1 || true
    if runuser -u kerstker -- env \
      XDG_RUNTIME_DIR="/run/user/$old_uid" \
      DBUS_SESSION_BUS_ADDRESS="unix:path=$old_bus" \
      systemctl --user is-active --quiet "$unit"; then
      die "obsolete user unit is still active: $unit"
    fi
  done
  stage_pass exact_obsolete_user_units_inactive
else
  printf 'OLD_USER_TRANSIENT_STOP_SKIPPED reason=session_bus_absent units=%s\n' \
    "${OLD_USER_UNITS[*]}"
  stage_pass session_bus_absent_no_broad_process_cleanup_attempted
fi

for unit in "${RESIDENT_UNITS[@]}" "${WORKER_TIMERS[@]}" quantos-l2-watchdog.timer; do
  systemctl is-active --quiet "$unit" || die "final required unit is not active: $unit"
done
for unit in "${RESIDENT_UNITS[@]}"; do
  systemctl is-enabled --quiet "$unit" || die "final resident unit is not enabled: $unit"
done
watchdog_status=$(systemctl show quantos-l2-watchdog.service -p ExecMainStatus --value)
watchdog_result=$(systemctl show quantos-l2-watchdog.service -p Result --value)
[[ "$watchdog_result" == success && ( "$watchdog_status" == 0 || "$watchdog_status" == 2 ) ]] \
  || die 'final watchdog result is not an accepted systemd success'
trap - EXIT
printf 'DGX_ARM64_RELEASE_DEPLOY_PASS release=%s source=%s manifest=%s watchdog_status=%s backup=scheduled_only wikimedia=scheduled_only alpha_search=complete forward=initialized elapsed=%ss\n' \
  "$RELEASE_COMMIT" "$SOURCE_COMMIT" "$EVIDENCE_MANIFEST_SHA256" \
  "$watchdog_status" "$((SECONDS - DEPLOY_STARTED_SECONDS))"
