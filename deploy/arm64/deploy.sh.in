fi
[[ -z $(git -C "$RELEASE" status --porcelain=v1 --untracked-files=all --ignore-submodules=none) ]] \
  || die 'installed release is dirty'
cmp -s "$BASELINE_ROOT/requirements.txt" "$RELEASE/requirements.txt" \
