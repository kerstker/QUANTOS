VERIFY_CODE='import sys; from pathlib import Path; root=Path(sys.argv[1]); sys.path.insert(0,str(root)); from scripts.evidence_binding import assert_release_evidence_manifest,resolve_canonical_source_anchor; from tools.l2_schedule_entrypoint import _verify_release_evidence,_verify_release_identity; release,source,expected=sys.argv[2:5]; assert resolve_canonical_source_anchor(root)==source; document,digest=assert_release_evidence_manifest(root,expected_release_commit=release); assert digest==expected; _verify_release_identity(root,release); _verify_release_evidence(root,release)'
runuser -u quantos -- env -i HOME=/tmp PATH=/usr/bin:/bin \
  PYTHONPATH="$RELEASE" LIVE_TRADING_ENABLED=false REAL_BROKER_ENABLED=false \
  ALLOW_ORDER_SUBMISSION=false ALLOW_AI_DIRECT_TRADING=false \
  REQUIRE_HUMAN_APPROVAL=true QUANTOS_L2_DRY_RUN_ONLY=true \
  QUANTOS_RELEASE_ROOT="$RELEASE" QUANTOS_RELEASE_COMMIT="$RELEASE_COMMIT" \
  QUANTOS_STATE_ROOT="$STATE_ROOT" \
  "$VENV/bin/python" -P -c "$VERIFY_CODE" \
  "$RELEASE" "$RELEASE_COMMIT" "$SOURCE_COMMIT" "$EVIDENCE_MANIFEST_SHA256"
env -i HOME=/tmp PATH=/usr/bin:/bin PYTHONPATH="$RELEASE" \
  "$VENV/bin/python" -P -m tools.build_arm64_release_package verify "$PACKAGE_DIR" \
  >/dev/null

if [[ -e "$FRONTEND" || -L "$FRONTEND" ]]; then
