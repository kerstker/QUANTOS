[Unit]
Description=QUANTOS Binance public realtime stream (L2 dry-run only)
Documentation=file:///opt/quantos/releases/__QUANTOS_RELEASE_SHA__/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quantos
Group=quantos
UMask=0077
# The five non-negotiable flags are literal unit properties. Do not add an
# EnvironmentFile here: systemd environment files override Environment= values
# regardless of their textual order.
Environment=LIVE_TRADING_ENABLED=false
Environment=REAL_BROKER_ENABLED=false
Environment=ALLOW_ORDER_SUBMISSION=false
Environment=ALLOW_AI_DIRECT_TRADING=false
Environment=REQUIRE_HUMAN_APPROVAL=true
Environment=QUANTOS_L2_DRY_RUN_ONLY=true
Environment=QUANTOS_RELEASE_ROOT=/opt/quantos/releases/__QUANTOS_RELEASE_SHA__
Environment=QUANTOS_RELEASE_COMMIT=__QUANTOS_RELEASE_SHA__
Environment=QUANTOS_STATE_ROOT=/srv/quantos/state
# Public-data transport only. The operator imports values into the system
# manager by name; no proxy value is stored in this unit or release evidence.
PassEnvironment=HTTP_PROXY HTTPS_PROXY FTP_PROXY NO_PROXY ALL_PROXY http_proxy https_proxy ftp_proxy no_proxy all_proxy
WorkingDirectory=/srv/quantos/state
ExecStart=/opt/quantos/venvs/__QUANTOS_RELEASE_SHA__/bin/python /opt/quantos/releases/__QUANTOS_RELEASE_SHA__/tools/l2_schedule_entrypoint.py binance_realtime_stream --release-commit __QUANTOS_RELEASE_SHA__
TimeoutStartSec=5m
Restart=always
RestartSec=30s
RuntimeMaxSec=23h55m
KillMode=control-group
TimeoutStopSec=90s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/opt/quantos/releases/__QUANTOS_RELEASE_SHA__
ReadWritePaths=/srv/quantos/state

# Input template: deliberately not installable. The renderer appends metadata.
