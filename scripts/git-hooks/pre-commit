#!/bin/sh
# QUANTOS pre-commit:快速检查(仓库整洁 + 治理扫描 + 密钥防呆)。完整门禁在 pre-push。
set -e
ROOT="$(git rev-parse --show-toplevel)"

# 1) 绝不提交 key/ 下的文件或 *coinkey* (密钥)
if git diff --cached --name-only | grep -Ei '(^|/)key/|coinkey' >/dev/null 2>&1; then
  echo "✖ 拒绝提交:暂存区里有 key/ 目录下的文件或 coinkey(密钥),它们必须保持 gitignore。" >&2
  exit 1
fi

# 2) 粗粒度密钥扫描(暂存内容)
if git diff --cached -U0 --no-color \
   | grep -nE 'CG-[A-Za-z0-9]{8,}|api[_-]?key[[:space:]]*=[[:space:]]*["'"'"'][A-Za-z0-9]{16,}' \
   >/dev/null 2>&1; then
  echo "✖ 拒绝提交:暂存改动疑似包含 API key / 密钥。" >&2
  echo "  若确属误报,人工复核后用 git commit --no-verify。" >&2
  exit 1
fi

# 3) 仓库布局与公开文档(快、离线)
python "$ROOT/scripts/check_repository_hygiene.py"

# 4) 治理扫描器(快、离线)
python "$ROOT/apps/research-console/scripts/run_paper_to_live_governance_check.py"
echo "✓ pre-commit:仓库整洁 + 治理扫描 + 密钥防呆 通过"
