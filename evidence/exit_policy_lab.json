  "selection_rule": {
    "version": "exit_lab_selection.v1",
    "text": "A policy is 'worth further study' ONLY IF ALL of: (1) Sharpe delta > 0 (RAW series); (2) maxDD not worsened by more than 2pp (mdd_delta <= 0.02); (3) delta not concentrated: if incremental PnL > 0, at least 5 periods are needed to cover it (negative/zero delta cannot be 'concentrated' and does not block); (4) profit factor >= baseline profit factor (both computed; None PF fails unless baseline PF is also None). Ranking is reported on multiple criteria (Sharpe delta / maxDD delta / PF delta); selection by final net PnL alone is FORBIDDEN (spec §8/§2.3).",
    "thresholds": {
      "mdd_tolerance": 0.02,
      "min_periods_for_delta": 5,
      "soft_warning_periods": 10
    }
  },
  "metric_definitions": {
    "profit_factor": "sum(positive period $PnL) / |sum(negative period $PnL)|; None if no losing period",
    "right_tail_share": "share of total net $PnL from the top ceil(n/10) periods by $PnL; None if total <= 0 (>1 means the rest of the book nets negative)",
    "delta_concentration": "min count of top period (policy-baseline) $ deltas needed to cover the total positive delta; <5 hard-fails selection, <10 warns",
    "cost_total": "final_equity(zero-cost twin run) - final_equity(cost run); fills are identical across the twin (quantities depend on fixed AUM+prices only)",
    "incremental": "every delta is policy minus signal-only baseline on the SAME periods/costs/AUM/seed"
  },
