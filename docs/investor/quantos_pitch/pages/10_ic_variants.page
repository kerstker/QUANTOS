  - elementId: var-n2
    elementType: text
    bounds: [510, 214, 120, 54]
    content: {style: "$bignum", fontSize: 38, wrap: false, text: "7 / 9"}
  - elementId: var-n2-label
    elementType: text
    bounds: [636, 216, 250, 52]
