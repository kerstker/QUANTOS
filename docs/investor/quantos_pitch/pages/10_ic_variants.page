pageType: content
background:
  type: solid
  color: "$bg"
elements:
  - elementId: kicker
    elementType: text
    bounds: [80, 40, 400, 18]
    content: {style: "$small", color: "$accent", letterSpacing: 3, wrap: false, text: "07 · 统计证据"}
  - elementId: title
    elementType: text
    bounds: [80, 62, 820, 38]
    content: {style: "$h1", wrap: false, text: "IC 面板 × 预注册变体族：先注册假设，后跑检验"}
  - elementId: ic-title
    elementType: text
    bounds: [80, 116, 400, 24]
    content: {style: "$h2", wrap: false, text: "截面 rank IC（crowd_contra）"}
  - elementId: ic-table
    elementType: table
    bounds: [80, 146, 380, 108]
    columnWidths: [0.28, 0.24, 0.24, 0.24]
    rowHeights: [0.34, 0.33, 0.33]
    style: "$dark"
    rows:
      - - text: "持有期"
        - text: "mean IC"
        - text: "t-stat"
        - text: "命中率"
      - - text: "7 天"
        - text: "+0.023"
        - {text: "2.79", bold: true, color: "$accent"}
        - text: "54.5%"
      - - text: "14 天"
        - text: "+0.030"
        - {text: "2.73", bold: true, color: "$accent"}
        - text: "59.9%"
  - elementId: ic-note
    elementType: text
    bounds: [80, 262, 380, 90]
    content:
      style: "$small"
      text: |
        <p>对照：carry_composite 对价格 IC≈0（t=0.18）—— 诚实：carry 的边在资金费现金流，非价格方向预测</p>
        <p style="margin-top:6px">momentum_7_wide（336 币宽宇宙）IC = -0.063，与既有负夏普结论一致</p>
  - elementId: var-title
    elementType: text
